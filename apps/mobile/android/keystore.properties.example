# Copy this file to apps/mobile/android/keystore.properties and fill in the two
# passwords. The copy is gitignored and must never be committed.
#
# When keystore.properties is absent, Gradle reads these four values from the
# environment instead:
#   storeFile     <- ANDROID_KEYSTORE_PATH
#   storePassword <- ANDROID_KEYSTORE_PASSWORD
#   keyAlias      <- ANDROID_KEY_ALIAS
#   keyPassword   <- ANDROID_KEY_PASSWORD
storeFile=/path/to/daak-upload.jks
storePassword=your-store-password
keyAlias=daak
keyPassword=your-key-password
