<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Daak is LAN-only: mDNS discovery needs multicast lock/state control. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Package visibility, API 30+ (Android 11). Since API 30 an app cannot see
      other apps' intent filters unless it declares a <queries> element for
      them, so DaakFsPathsModule's resolveActivity() would answer null for
      every ACTION_VIEW and startActivity() would throw ActivityNotFoundException,
      making reveal a silent no-op on every modern device. This declares
      visibility only; it grants no permission and does not export anything.
    -->
    <queries>
      <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:mimeType="*/*" />
      </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!--
          daak:// deep links: `send?deviceId=..&text=..` and
          `pair?bundle=..`. apps/mobile/src/deeplink.ts parses both and its
          suite is green, but a parser with no registered scheme has no caller:
          Android resolved no activity for a daak:// intent and answered
          "Activity not started, unable to resolve Intent", so a pairing link
          reached iOS and macOS and died on Android.

          ONE filter with two <data> elements, not two filters. Android merges
          every <data> in one filter into a cross-product, so scheme + host
          here matches daak://send AND daak://pair, and a second filter would
          only let a browser offer Daak twice.

          BROWSABLE is what makes the link openable from a web page or a
          message. Without it Android refuses the intent from any non-browser
          caller. DEFAULT is required for an implicit intent to resolve at all.

          singleTask is already declared above, so a link into a RUNNING app
          arrives on onNewIntent and Linking.getInitialURL() sees it on the
          cold path. Nothing else is needed.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="daak" />
            <data android:host="send" />
            <data android:host="pair" />
        </intent-filter>
      </activity>
      <!--
        Inbound share target. Translucent and no UI of its own: it only stages
        the bytes into filesDir/share-inbox and wakes the host. It never sends,
        never contacts a peer and does no crypto; the engine outbox owns
        delivery. Deliberately no android:launchMode: a single-shot activity is
        recreated per share instead of reused, because a reused one routes the
        next share to an onNewIntent this class does not override, and the
        share is then silently dropped.
      -->
      <activity
        android:name=".share.ShareTargetActivity"
        android:exported="true"
        android:excludeFromRecents="true"
        android:theme="@style/Theme.Daak.ShareTarget">
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="text/plain" />
            <data android:mimeType="image/*" />
            <data android:mimeType="video/*" />
            <data android:mimeType="application/*" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="*/*" />
        </intent-filter>
      </activity>
      <!--
        modules/rn-fspaths reveals a saved file with ACTION_VIEW, and a file://
        URI throws FileUriExposedException on API 24+. The provider is NOT
        exported and grants nothing on its own; every grant is per-Intent and
        read-only, added at the call site.

        The authority is FIXED, not applicationId-derived, because
        DaakFsPathsModule.kt passes it to FileProvider.getUriForFile(context,
        AUTHORITY, file), which throws IllegalArgumentException on an authority
        that is not in the merged manifest. modules/rn-share declares the
        applicationId-derived authority for its own provider, and two providers
        cannot share one, so the two authorities have to differ. Both halves are
        pinned by apps/mobile/src/__tests__/nativeStoreAndPaths.test.ts.
      -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="dev.darshit.daak.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <!--
          modules/rn-share declares a FileProvider too, and the manifest merger
          keys provider on android:name, which is the same androidx class in
          both, so the two entries COLLAPSE into one element carrying both
          FILE_PROVIDER_PATHS children, and the two different android:resource
          values collide. The authorities do NOT collide: rn-share's
          ${applicationId}.fileprovider resolves to exactly this string.

          tools:replace on the meta-data is the fix, not a workaround. The
          surviving @xml/daak_fspaths_file_paths declares files-path,
          external-files-path and cache-path, the same three roots
          @xml/daak_file_paths declared. The files-path roots name only
          daak/downloads/ and share-inbox/, so the database and the identity
          under filesDir are never served. Every path rn-share's
          getUriForFile() resolves (its share-inbox lives under cacheDir)
          still resolves. One provider with one meta-data instead of
          two would have been the alternative; that needs rn-share to stop
          declaring its own, which is more churn for the same result.
        -->
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/daak_fspaths_file_paths"
          tools:replace="android:resource" />
      </provider>
    </application>
</manifest>
