# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Pinned, not min_ios_version_supported: RN 0.76.5's helpers.rb returns 15.1, but
# the app's IPHONEOS_DEPLOYMENT_TARGET is 16.0 (App Intents need 16+), and
# DaakShare.podspec declares 16.0. A Podfile below the podspec floor fails lint.
platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The share extension is pure UIKit + the App Group inbox. No RN, no pods: it
# stages bytes/text and never talks to the engine. Declared so CocoaPods does
# not complain about a project target it has never been told about.
target 'DaakShareExtension' do
end

target 'Daak' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :new_arch_enabled => true,
    :hermes_enabled => true
  )

  target 'DaakTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
