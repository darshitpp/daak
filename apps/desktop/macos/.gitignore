# CocoaPods
Pods/

# CocoaPods codegen output (ReactCodegen, FBReactNativeSpec). Regenerated by
# `pod install` on every machine, and apps/mobile/ios/.gitignore excludes the
# same directory for the same reason.
build/

# Written by `pod install` on this host, pinning the absolute path of whatever
# node it found. Machine-specific, so it must not be committed -- the checked-in
# .xcode.env resolves node from PATH instead.
.xcode.env.local
