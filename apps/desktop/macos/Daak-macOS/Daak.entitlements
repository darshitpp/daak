<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The Share Extension stages inbound shares into the App Group; the host
	     drains them through engine.send. Both halves need the same group, which
	     is why the extension is not sandboxed to a path. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>J6NNRLDUG4.group.dev.darshit.daak</string>
	</array>
	<!-- READ-WRITE, and the R42p destination feature is why. A user-selected
	     folder was granted read-only here, so the sandbox denied every move into
	     the folder the user had just chosen: the app could read the folder and
	     could not put anything in it. The failure was invisible rather than loud
	     -- moveReceivedFiles keeps the ORIGINAL path when a move fails, by
	     design -- so the file simply never appeared, with no error anywhere. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The engine binds a TCP listener in-process (D16.10.3), so the app needs
	     server as well as client. client-only was correct for the daakd shape,
	     where the app talks out and the daemon binds. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- D16.12.5: the identity keychain needs this. kSecUseDataProtectionKeychain
	     is available only to a sandboxed app that holds keychain-access-groups,
	     and WITHOUT the entitlement every SecItem call returns
	     errSecMissingEntitlement (-34018). That is not an ad-hoc-only failure: a
	     signature grants what this plist REQUESTS and invents nothing, so an
	     earlier version of this file that omitted the key would have made the
	     engine unstartable on a properly signed build too. Requested with an
	     explicit group. AGENTS.md writes the plain group.dev.darshit.daak form,
	     but the four Xcode profiles grant NO App Group, so the registered form
	     cannot be used on macOS. Apple's registration-free form is
	     <team id>.<group name>: J6NNRLDUG4.group.dev.darshit.daak. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.dev.darshit.daak</string>
	</array>
</dict>
</plist>
