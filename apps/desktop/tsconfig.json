{
  "extends": "@react-native/typescript-config",
  // "node" is not in the RN preset's `types` (it is exactly
  // ["react-native","jest"]). Desktop imports @daak/core's DaemonClient half
  // at RUNTIME -- unlike mobile, which only takes its types -- and that half is
  // a Node daemon client using Buffer and node:net. "jest" is deliberately
  // absent: this package tests with vitest, and the include below is narrow so
  // no OTHER package's jest-only test files get pulled into this program.
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    // The preset sets allowJs but not checkJs, so index.js was in the program
    // without being checked: mode="popovr" passed CI silently. index.js is the
    // whole deliverable -- it wires the engine and registers both roots -- so it
    // gets checked. This is the only tsconfig in the repo with checkJs; that is
    // deliberate for Phase 6 and the other packages are left alone.
    "checkJs": true,
    "types": ["react-native", "node"]
  },
  // tsc follows the @daak/core and @daak/ui imports transitively (they are .ts
  // sources, not .d.ts), so listing ../../packages/*/src here would add nothing
  // except every sibling package's *.test.ts(x), which are written against
  // their own runners and do not belong in this program.
  // ../../apps/mobile/src/deeplink is listed because
  // test/direct-share-contract.spec.ts imports the REAL mobile parser across the
  // package boundary. tsc only type-checks files reachable from the program, so
  // without the explicit path that import is an untyped hole -- and it is exactly
  // that import which keeps the two apps' daak:// contract from drifting.
  // "types" holds this package's own module declarations (react-test-renderer,
  // which ships none and whose @types package is not in this offline
  // workspace). Narrow include means nothing else in the repo picks them up.
  // ../../packages/ui/src/assets/png.d.ts is the `*.png` module declaration.
  // tsc follows the @daak/ui import into Wordmark.tsx, which imports a PNG, so
  // that program needs the declaration even though it is not this package's.
  "include": ["src", "test", "types", "index.js", "../../apps/mobile/src/deeplink.ts", "../../packages/ui/src/assets/png.d.ts"]
}
