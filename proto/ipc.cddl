; proto/ipc.cddl
;
; IPC schema for the desktop DaemonClientEngine <-> daakd protocol (spec §6.3).
; Mirrors the IpcMessage / IpcRequest / IpcResponse / IpcEvent enums defined in
; docs/superpowers/plans/2026-09-14-phase-4-ffi-turbomodule-daemon.md (Task 5),
; with one addition: every top-level frame carries the schema version "v" so a
; version mismatch is explicit rather than a decode failure (spec §1.3.5).
;
; This file is the source of truth. Rust and TypeScript types are generated from
; it by proto/codegen.sh. Never edit proto/gen by hand.

; ---------- envelope ----------
ipc-message = {
  "v":   uint,                        ; IPC schema version; bump on breaking change
  "msg": ipc-request / ipc-response / ipc-event,
  ? "extensions": extensions,         ; forward-compat fields: preserved, never fatal
}

extensions = { * tstr => any }

; ---------- IpcRequest ----------
ipc-request =
    start-request
  / subscribe-request
  / devices-request
  / pair-request
  / send-request
  / cancel-request
  / retry-request
  / list-transfers-request
  / list-inbox-request
  / set-display-name-request
  / set-presence-request
  / shutdown-request

start-request            = { "Start": start-args }
subscribe-request        = "Subscribe"
devices-request          = "Devices"
pair-request             = { "Pair": pair-args }
send-request             = { "Send": send-args }
cancel-request           = { "Cancel": transfer-ref }
retry-request            = { "Retry": transfer-ref }
list-transfers-request   = "ListTransfers"
list-inbox-request       = "ListInbox"
set-display-name-request = { "SetDisplayName": display-name-args }
set-presence-request     = { "SetPresence": set-presence-args }
shutdown-request         = "Shutdown"

transfer-ref = { "transfer_id": tstr }

start-args = {
  "data_dir":     tstr,
  "display_name": tstr,
  "listen_port":  uint,
}

pair-args = { "addr": tstr, "bundle_cbor": bstr }

send-args = {
  "peer_device_id": tstr,
  "text":           tstr / null,
  "files":          [* tstr],
}

display-name-args = { "name": tstr }

set-presence-args = { "state": tstr }

; ---------- IpcResponse ----------
ipc-response =
    ok-response
  / error-response
  / json-response
  / port-response

ok-response    = "Ok"
error-response = { "Error": error-args }
json-response  = { "Json": json-args }
port-response  = { "Port": port-args }

error-args = { "message": tstr }
json-args  = { "value": tstr }
port-args  = { "port": uint }

; ---------- IpcEvent (mirrors spec §6.1) ----------
ipc-event =
    device-found-event
  / device-state-event
  / pairing-sas-event
  / transfer-progress-event
  / transfer-done-event
  / transfer-failed-event
  / inbox-received-event

device-found-event      = { "DeviceFound": device-found-args }
device-state-event      = { "DeviceState": device-state-args }
pairing-sas-event       = { "PairingSas": pairing-sas-args }
transfer-progress-event = { "TransferProgress": transfer-progress-args }
transfer-done-event     = { "TransferDone": transfer-ref }
transfer-failed-event   = { "TransferFailed": transfer-failed-args }
inbox-received-event    = { "InboxReceived": inbox-received-args }

device-found-args      = { "device_id": tstr, "name": tstr, "addr": tstr }
device-state-args      = { "device_id": tstr, "online": bool }
pairing-sas-args       = { "peer_device_id": tstr, "sas": tstr }
transfer-progress-args = { "transfer_id": tstr, "bytes_done": uint, "bytes_total": uint }
transfer-failed-args   = { "transfer_id": tstr, "error": tstr }
inbox-received-args    = { "payload": tstr }
