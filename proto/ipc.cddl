; proto/ipc.cddl
;
; IPC schema for the desktop DaemonClientEngine <-> daakd protocol (spec §6.3).
; Mirrors the IpcMessage / IpcRequest / IpcResponse / IpcEvent enums defined in
; docs/superpowers/plans/2026-09-14-phase-4-ffi-turbomodule-daemon.md (Task 5),
; with one addition: every top-level frame carries the schema version "v" so a
; version mismatch is explicit rather than a decode failure (spec §1.3.5).
;
; This file is the source of truth. Rust and TypeScript types are generated from
; it by proto/codegen.sh. Never edit proto/gen by hand.

; ---------- envelope ----------
ipc-message = {
  "v":   uint,                        ; IPC schema version; bump on breaking change
  "msg": ipc-request / ipc-response / ipc-event,
  ? "extensions": { * tstr => any },  ; forward-compat fields: preserved, never fatal
}

; ---------- IpcRequest ----------
ipc-request =
    start-request
  / subscribe-request
  / devices-request
  / pair-request
  / send-request
  / cancel-request
  / retry-request
  / list-transfers-request
  / list-inbox-request
  / set-display-name-request
  / set-presence-request
  / shutdown-request

start-request            = { "Start": start-args }
subscribe-request        = "Subscribe"
devices-request          = "Devices"
pair-request             = { "Pair": pair-args }
send-request             = { "Send": send-args }
cancel-request           = { "Cancel": { "transfer_id": tstr } }
retry-request            = { "Retry": { "transfer_id": tstr } }
list-transfers-request   = "ListTransfers"
list-inbox-request       = "ListInbox"
set-display-name-request = { "SetDisplayName": { "name": tstr } }
set-presence-request     = { "SetPresence": { "state": tstr } }
shutdown-request         = "Shutdown"

start-args = {
  "data_dir":     tstr,
  "display_name": tstr,
  "listen_port":  uint,
}

pair-args = { "addr": tstr, "bundle_cbor": bstr }

send-args = {
  "peer_device_id": tstr,
  "text":           tstr / null,
  "files":          [* tstr],
}

; ---------- IpcResponse ----------
ipc-response =
    ok-response
  / error-response
  / json-response
  / port-response

ok-response    = "Ok"
error-response = { "Error": { "message": tstr } }
json-response  = { "Json": { "value": tstr } }
port-response  = { "Port": { "port": uint } }

; ---------- IpcEvent (mirrors spec §6.1) ----------
ipc-event =
    device-found-event
  / device-state-event
  / pairing-sas-event
  / transfer-progress-event
  / transfer-done-event
  / transfer-failed-event
  / inbox-received-event

device-found-event      = { "DeviceFound": { "device_id": tstr, "name": tstr, "addr": tstr } }
device-state-event      = { "DeviceState": { "device_id": tstr, "online": bool } }
pairing-sas-event       = { "PairingSas": { "peer_device_id": tstr, "sas": tstr } }
transfer-progress-event = { "TransferProgress": { "transfer_id": tstr, "bytes_done": uint, "bytes_total": uint } }
transfer-done-event     = { "TransferDone": { "transfer_id": tstr } }
transfer-failed-event   = { "TransferFailed": { "transfer_id": tstr, "error": tstr } }
inbox-received-event    = { "InboxReceived": { "payload": tstr } }
