; proto/ipc.cddl
;
; IPC schema for the desktop daakd <-> DaemonClientEngine protocol (spec 6.3).
; This file is the schema source of truth; the wire layout is documented in
; crates/daak-ipc/src/lib.rs and the encoding is CHECKED against this file by
; crates/daak-ipc/tests/schema.rs.
;
; GENERATED FROM / CHECKED AGAINST THE SERDE DERIVES, not the other way round.
; The Rust enums use serde's default EXTERNALLY TAGGED representation, which
; is what T7 byte-verified against the cbor-x config in
; packages/core/src/ipc/transport.ts. So a message is a ONE-KEY MAP whose key
; is the PascalCase variant name, and a UNIT variant is a bare string:
;
;   IpcRequest::Subscribe   -> {"Request": "Subscribe"}
;   IpcRequest::Start{..}   -> {"Request": {"Start": {..}}}
;   IpcResponse::Ok        -> {"Response": "Ok"}
;   IpcResponse::Json{..}  -> {"Response": {"Json": {"value": "<STRING>"}}}
;
; cddl-codegen's output for this file RENAMES every variant (IpcRequest::Subscribe
; becomes enum SubscribeRequest with a ValueText... variant) and so looks like a
; different wire. It is not: proto/gen/rust/ipc was MEASURED to emit the same
; bytes for Subscribe, Ok, Start, Error and Pair. It is not used at runtime for
; one concrete reason: its deserializer REJECTS an unknown map key
; (DefiniteLenMismatch), which would break the forward compatibility the "v"
; header exists to buy -- a 1.9 peer adding a field would be undecodable by a
; 1.0 daemon built from these types. So the Rust and TS types come from the
; serde derives, which ignore unknown fields, and this file is the source of
; truth they are pinned against by crates/daak-ipc/tests/schema.rs. proto/gen
; is committed for REVIEW and schema-diff purposes ONLY. Do not re-tag the
; enums to suit the generator: that would break every hex fixture in
; packages/core/test/transport.spec.ts.
;
; "v" is the IPC schema version, a uint whose HIGH BYTE is the major and low
; byte the minor (spec 1.3.5). A peer is compatible when (v >> 8) == IPC_MAJOR,
; so a newer minor is accepted and a different major is refused with
; IpcResponse::UpdateRequired / IpcError::UpdateRequired.

; ---------- frame ----------
ipc-frame = {
  "v":   uint,
  "msg": ipc-message,
}

; Each arm is its OWN named rule, not an inline map: the pinned cddl-codegen
; rejects a heterogeneous inline map used as a type inside a choice group
; ("Anonymous groups not allowed: a heterogeneous inline map is used where a
; type is required").
ipc-message = request-arm / response-arm / event-arm

request-arm  = { "Request":  ipc-request }
response-arm = { "Response": ipc-response }
event-arm    = { "Event":    ipc-event }

; ---------- IpcRequest ----------
ipc-request =
    start-request
  / subscribe-request
  / devices-request
  / pair-request
  / send-request
  / cancel-request
  / retry-request
  / list-transfers-request
  / list-inbox-request
  / set-display-name-request
  / set-presence-request
  / shutdown-request

start-request            = { "Start": start-args }
subscribe-request        = "Subscribe"
devices-request          = "Devices"
pair-request             = { "Pair": pair-args }
send-request             = { "Send": send-args }
cancel-request           = { "Cancel": transfer-ref }
retry-request            = { "Retry": transfer-ref }
; filter is OPTIONAL and its two fields are independently OPTIONAL, so
; {"ListTransfers": {}} (list everything) is a DIFFERENT frame from
; {"ListTransfers": "ListTransfers"}. daak-ipc's TransferFilter uses
; skip_serializing_if so an empty filter encodes as {}, and the field is
; Option so a missing filter is a unit variant. Both are pinned by
; crates/daak-ipc/tests/schema.rs.
list-transfers-request   = list-transfers-args
list-inbox-request       = "ListInbox"
set-display-name-request = { "SetDisplayName": display-name-args }
set-presence-request     = { "SetPresence": set-presence-args }
shutdown-request         = "Shutdown"

transfer-ref = { "transfer_id": tstr }

start-args = {
  "data_dir":     tstr,
  "display_name": tstr,
  "listen_port":  uint,
}

pair-args = { "addr": tstr, "bundle_cbor": bstr }

send-args = {
  "peer_device_id": tstr,
  "text":           tstr / null,
  "files":          [* tstr],
}

display-name-args = { "name": tstr }
set-presence-args = { "state": tstr }

list-transfers-args = {
  ? "filter": transfer-filter,
}

transfer-filter = {
  ? "state":           tstr,
  ? "peer_device_id": tstr,
}

; ---------- IpcResponse ----------
ipc-response =
    ok-response
  / error-response
  / json-response
  / port-response
  / update-required-response

ok-response    = "Ok"
error-response = { "Error": error-args }
json-response  = { "Json": json-args }
port-response  = { "Port": port-args }

; Answered when the peer's frame major does not match ours. min_major is the
; lowest major this daemon understands, so an old client knows what to fetch.
update-required-response = { "UpdateRequired": update-required-args }

error-args           = { "message": tstr }
json-args            = { "value": tstr }
port-args            = { "port": uint }
update-required-args = { "min_major": uint }

; ---------- IpcEvent (mirrors spec 6.1) ----------
ipc-event =
    device-found-event
  / device-state-event
  / pairing-sas-event
  / transfer-progress-event
  / transfer-item-event
  / transfer-done-event
  / transfer-failed-event
  / inbox-received-event

device-found-event      = { "DeviceFound": device-found-args }
device-state-event      = { "DeviceState": device-state-args }
pairing-sas-event       = { "PairingSas": pairing-sas-args }
transfer-progress-event = { "TransferProgress": transfer-progress-args }
transfer-item-event     = { "TransferItem": transfer-item-args }
transfer-done-event     = { "TransferDone": transfer-ref }
transfer-failed-event   = { "TransferFailed": transfer-failed-args }
inbox-received-event    = { "InboxReceived": inbox-received-args }

device-found-args      = { "device_id": tstr, "name": tstr, "addr": tstr }
device-state-args      = { "device_id": tstr, "online": bool }
pairing-sas-args       = { "peer_device_id": tstr, "sas": tstr }
transfer-progress-args = { "transfer_id": tstr, "bytes_done": uint, "bytes_total": uint }
transfer-item-args     = { "transfer_id": tstr, "item_index": uint, "state": tstr, "dest_path": tstr }
transfer-failed-args   = { "transfer_id": tstr, "error": tstr }
; payload_json is a raw JSON STRING, not an InboxEntry: the daemon does not
; parse it and the client JSON.parses it before handing the event to TS.
inbox-received-args    = { "payload_json": tstr }
