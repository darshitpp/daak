payload-manifest = {
  "v":            uint,
  "payload_id":   bstr .size 16,
  "kind":         tstr, ; "text" | "media" | "batch" | future
  "created_at":   uint,
  "sender":       device-ref,
  "items":        [* item],
  ? "meta":       { * tstr => any },
  ? "extensions": { * tstr => any },
  ? "reply_to":   bstr .size 16,
}

device-ref = { "device_id": bstr .size 16, "name": tstr }

item = {
  "index":       uint,
  ; @name item_type: "type" is a Rust keyword, so the generator renames the
  ; struct field. The CBOR wire key stays the bareword text "type".
  "type":        tstr, ; @name item_type
  ? "name":      tstr,
  ? "mime":      tstr,
  ? "size":      uint,
  ? "hash":      bstr .size 32,
  ? "text":      tstr,
  ? "chunk_size": uint,
  ? "chunk_count": uint,
  ? "children":  [* item],
  ? "reply_to":  bstr .size 16,
  ? "attrs":     { * tstr => any },
}
