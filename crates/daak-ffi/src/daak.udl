namespace daak_ffi {};

[Error]
enum FfiError {
  "Engine",
  "Protocol",
};

// A FIELDED error, declared as an `[Enum] interface` because UDL's `enum`
// syntax only ever produces a FLAT error (converters/enum_.rs:14-19). uniffi
// 0.28.3 emits `#[uniffi(with_try_read)]` for a flat error the moment one
// CALLBACK method throws it, and that try_read rebuilds the variant as the
// UNIT variant, so a flat error here makes the scaffolding fail to compile.
// A separate type from FfiError so every ENGINE error still surfaces as
// Engine or Protocol.
[Error]
interface FfiStoreError {
  // `reason`, NOT `message`. uniffi_bindgen 0.28.3's ErrorTemplate.kt emits
  // each field as a `val <name>` on a class that extends kotlin.Exception, and
  // Throwable already declares `message`. A field named `message` therefore
  // generates `val `message`: kotlin.String` alongside `override val message`
  // and :app:compileDebugKotlin fails with "Conflicting declarations" plus a
  // recursive-type-check error on the field_name interpolation. There is no
  // UDL keyword to escape a field name (macros.kt field_name emits
  // field.name()|var_name verbatim, backtick-quoting only), so the only fix is
  // to not use the name. The exception's own .message still renders it, as
  // "reason=<text>".
  Store(string reason);
};

callback interface EventSink {
  void on_event(FfiEvent event);
};

// The OS keystore, as a callback: the Rust engine never opens a keystore
// itself, the platform binding does. Values cross as base64 STRINGS because the
// UDL has no byte-string type; a `string?` of null is "no such key", which is
// what a first launch looks like, and is not an error.
//
// Throwing FfiStoreError is the only honest failure here (R40(c)): a locked or
// unavailable keystore must REJECT the engine start, never fall back to a
// plaintext store, because a fresh identity silently re-pairs the device as a
// new one.
callback interface SecureStore {
  [Throws=FfiStoreError] string? get(string key);
  [Throws=FfiStoreError] void set(string key, string value);
  [Throws=FfiStoreError] void delete(string key);
};

// A single tagged union so the generated Rust enum and the callback match exactly.
[Enum]
interface FfiEvent {
  DeviceFound(DeviceFoundEvent data);
  DeviceState(DeviceStateEvent data);
  PairingSas(PairingSasEvent data);
  PairingDone(PairingDoneEvent data);
  TransferProgress(ProgressEvent data);
  TransferItem(TransferItemEvent data);
  TransferDone(DoneEvent data);
  TransferFailed(FailedEvent data);
  InboxReceived(InboxReceivedEvent data);
  // A peer this build refuses for a version reason, with BOTH real version
  // numbers. It is the only signal the UI has for the Open Design "update
  // required" screen, and it carries the numbers rather than making the UI
  // invent them.
  IncompatiblePeer(IncompatiblePeerEvent data);
};

dictionary DeviceFoundEvent { string device_id; string name; string addr; boolean online; };
dictionary DeviceStateEvent { string device_id; boolean online; };
dictionary PairingSasEvent { string peer_device_id; string sas; };
dictionary PairingDoneEvent { string device_id; };
dictionary ProgressEvent { string transfer_id; u64 bytes_done; u64 bytes_total; };
dictionary TransferItemEvent { string transfer_id; u32 item_index; string state; string dest_path; };
dictionary DoneEvent { string transfer_id; };
dictionary FailedEvent { string transfer_id; string error; };
dictionary InboxReceivedEvent { string payload_json; };
dictionary IncompatiblePeerEvent {
  string peer_device_id;
  string peer_name;
  // u16 both ways: PeerAnnounce.proto_version and manifest::MANIFEST_VERSION.
  u16 peer_version;
  u16 our_version;
};

interface DaakEngine {
  constructor(EventSink sink);
  // The mobile constructor: the Keychain/Keystore store the OS owns. Added as
  // a NAMED constructor rather than by changing `new`, so every existing
  // caller (and all 18 other methods) keeps its shape, and the desktop/CLI
  // path keeps the plaintext file default (R38/R39/R40(a)).
  [Name=new_with_store]
  constructor(SecureStore store, EventSink sink);
  [Throws=FfiError] void start(string data_dir, string display_name, u16 listen_port);
  [Throws=FfiError] string pairing_bundle();
  // C2: the HOST half of QR pairing. The host scanned the joiner's bundle, so
  // this takes the SAME bytes pair_with takes -- the bundle CBOR -- and arms
  // the accept slot for that peer. This is the RE-ARM path (a bundle is in
  // hand, e.g. a code-mode or re-arm caller). Re-armable: it replaces the
  // pending slot, so a host can re-offer after a failed or mismatched attempt
  // without restarting the engine.
  [Throws=FfiError] void offer_pairing(sequence<u8> bundle_cbor);
  // The host arm spec 3.3 Mode A actually needs, and it takes NO bundle. The QR
  // flow is asymmetric: only the JOINER scans, so only the joiner ever holds
  // the HOST's bundle, and the sanctioned flow never gives the host the
  // joiner's. An arm that requires one is unreachable by a real user, so this
  // arms the accept slot for the FIRST inbound pairing, learns the peer's
  // identity in-band, and verifies it in the Noise XX handshake (spec 3.5) plus
  // the SAS the user compares. One-shot: it is consumed by the connection it
  // accepts, so arm again to pair another device. TRUST SURFACE: the host has
  // no pre-known bundle, so it cannot pre-empt an identity substitution the way
  // offer_pairing does -- the SAS comparison is what binds the peer to the
  // human. See PendingArm::Open in crates/daak-core/src/engine.rs.
  [Throws=FfiError] void arm_host_pairing();
  [Throws=FfiError] string pair_with(string addr, sequence<u8> bundle_cbor);
  [Throws=FfiError] string accept_pairing();
  [Throws=FfiError] string send_text(string peer_id, string text);
  [Throws=FfiError] string send_files(string peer_id, sequence<string> paths);
  [Throws=FfiError] string list_devices();
  [Throws=FfiError] void cancel(string transfer_id);
  [Throws=FfiError] void retry(string transfer_id);
  // The filter crosses as a JSON string because the UDL has no map type; an
  // empty string or "{}" means no filter (list everything). Invalid JSON and a
  // malformed peerDeviceId are FfiError.Protocol, not a silent unfiltered list.
  [Throws=FfiError] string list_transfers(string filter_json);
  [Throws=FfiError] string list_inbox();
  // This device's OWN advertised name and device id, as JSON
  // `{name, deviceId}`. set_display_name existed with no reader, so the UI
  // could write a name it could never show back. `name` is the RESOLVED name
  // (with any LAN-collision suffix), which is what peers see.
  [Throws=FfiError] string self_profile();
  [Throws=FfiError] void set_display_name(string name);
  // 'online' or 'away' only; 'offline' is a peer's claim about us, not a state
  // this device can declare about itself.
  [Throws=FfiError] void set_presence(string state);
  [Throws=FfiError] u16 local_port();
  [Throws=FfiError] void shutdown();
  // The event callback carries an FfiEvent, not a string, so the platform
  // sinks need this to turn one into the JSON packages/core reads. Same mapping
  // as the ffi_event_json fn in lib.rs, declared here because only UDL items
  // reach uniffi codegen.
  [Throws=FfiError] string ffi_event_json(FfiEvent ev);
};
