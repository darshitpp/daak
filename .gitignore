# Dependencies
node_modules/

# Turborepo cache
.turbo/

# Design specs and implementation plans are intentionally local-only (not version-controlled)
docs/superpowers/specs/
docs/superpowers/plans/

# SDD scratch workspace (ledgers, briefs, reports)
.superpowers/

# Rust build output
/target/
proto/gen/rust/*/target/
proto/gen/rust/*/Cargo.lock

# Gradle output for the autolinked native modules. apps/mobile/.gitignore has a
# `build/` rule, but that file only covers apps/mobile/** -- the modules/*
# packages are siblings of it, not children, so their android/build/ dirs were
# untracked and unignored until the first Android build ever ran in this repo.
# Scoped to the exact path shape so it cannot swallow a source dir named build.
modules/*/android/build/

# Gradle output for the desktop Android app. apps/mobile/.gitignore covers
# apps/mobile/** only. apps/desktop is a sibling, so its build dirs stayed
# unignored until this rule existed. Scope the rule to the desktop path.
apps/desktop/android/app/build/

# React Native codegen output. Regenerated by `react-native codegen` on each
# machine. The source TurboModule specs live in packages/core/src and the
# module js/ dirs, so this output must not be committed.
apps/desktop/build/

# OS junk
.DS_Store

# pnpm store shadow: a local .pnpm-store/ shadows the real store on the next install
.pnpm-store/

# Xcode user state. SwiftPM writes machine-local settings into these dirs.
*.xcuserstate
*.pbxuser
*.xccheckout
*.moved-aside
*.xcuserdata/
**/xcshareddata/swiftpm/

# Rust workspace lockfile. AGENTS.md says this file is never versioned.
# Cargo generates it during the build. It stays local for reproducible builds.
Cargo.lock

# Agent skill lockfile. Generated by the skill installer. The source repos and
# hashes can be recomputed. The lockfile is machine-specific.
skills-lock.json

# Local agent configuration. Each tool keeps its own config here. The configs
# are machine-specific and must not leak into the shared repository.
.agents/
.claude/
.opencode/
.qwen/
.junie/
.idea/

# Local project instructions. AGENTS.md is the local agent instruction file.
# It is regenerated from the template. The project rules say it is never added.
AGENTS.md

# Gate scratch directory. Used for temporary gate output during verification.
.gate-tmp/

apps/mobile/android/keystore.properties
*.p12
*.pfx
*.mobileprovision
*.keystore
*.jks

# sverklo per-project state (memory journal, etc.)
.sverklo/

# agent tool config: .mcp.json holds a machine-specific path
.mcp.json
.github/copilot-instructions.md

# secrets and local state that must never reach the public repo
keystore.properties
.env
.env.*
xcuserdata/
docs/superpowers/
