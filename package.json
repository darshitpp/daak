{
  "name": "daak",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "proto:gen": "bash proto/codegen.sh",
    "proto:check": "bash proto/codegen.sh && git diff --exit-code -- proto/gen"
  },
  "devDependencies": {
    "turbo": "2.3.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.83.10": "patches/@react-native__gradle-plugin@0.83.10.patch"
    }
  }
}
