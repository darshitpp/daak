<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    POST_NOTIFICATIONS is a RUNTIME permission on API 33+. Without this entry
    requestPermissions can never grant, and on API 33+ a post with no grant is
    SILENTLY dropped: the user would never see a transfer banner and nothing
    would say why. Declared in the library manifest so it merges into the app.
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!--
      Hosts the foreground host-app launch for a tapped action. It exists
      because a BroadcastReceiver cannot bring an activity up under the
      background-start restrictions, and because a library cannot name the
      app's activity at compile time. Private, no UI, finishes immediately.
      It is NOT the inbound share target: ShareTargetActivity in the app is
      that, and it is android:exported=true.
    -->
    <activity
      android:name=".ShareTrampolineActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!--
      The target of every actionPending() PendingIntent. Without this entry the
      system cannot resolve the explicit intent, so all three action buttons are
      dead broadcasts and NotifyStash/emitToJs/the trampoline are unreachable.

      exported="false" is deliberate: every PendingIntent that reaches this
      receiver is an EXPLICIT intent built by this library for this app, and
      exported="true" would let any app on the device start it directly with a
      forged payload. Nothing needs to reach it from outside.
    -->
    <receiver
      android:name=".NotificationActionReceiver"
      android:exported="false" />
  </application>
</manifest>
