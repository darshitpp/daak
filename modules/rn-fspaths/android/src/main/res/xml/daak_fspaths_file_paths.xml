<?xml version="1.0" encoding="utf-8"?>
<!--
  A SEPARATE resource from modules/rn-share's daak_file_paths.xml on purpose:
  two provider entries in one merged manifest cannot share an
  android:authorities, so this module's paths carry a unique name and the APP
  manifest pairs them with its own authority. Both halves must be present:
  getUriForFile throws IllegalArgumentException on an undeclared authority.
-->
<paths>
  <files-path name="daak_fspaths_downloads" path="daak/downloads/" />
  <files-path name="daak_fspaths_inbox" path="share-inbox/" />
  <external-files-path name="daak_fspaths_ext" path="." />
  <cache-path name="daak_fspaths_cache" path="." />
</paths>
